# Copy to .env and fill in. Used by `pnpm dev` and `docker compose`.

# Postgres (docker compose creates the database with these credentials)
POSTGRES_USER=dicepoker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dicepoker
# Used by `pnpm dev` (the compose app service builds its own URL)
NUXT_DATABASE_URL=postgres://dicepoker:change-me@localhost:5432/dicepoker

# Session encryption + socket tokens, min. 32 characters (e.g. `openssl rand -base64 32`)
NUXT_SESSION_PASSWORD=

# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL)
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Only needed behind a reverse proxy, e.g. https://dice.example.com/api/auth/callback/google
NUXT_OAUTH_GOOGLE_REDIRECT_URL=
